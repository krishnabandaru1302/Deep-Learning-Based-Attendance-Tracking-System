APP_PORT=8000
MATCH_DISTANCE_THRESHOLD=0.35
# Keep camera credentials in the local .env file; never commit them.
# CAMERA_RTSP_URL=rtsp://username:password@camera-host/stream
CAMERA_ID=lecture-hall-a-door
CAMERA_DOOR_LINE_X=0.5
CAMERA_ENTRY_DIRECTION=right
CAMERA_SAMPLE_INTERVAL=0.5
CAMERA_TRACK_TIMEOUT=4
CAMERA_TRACK_MAX_X_GAP=0.15
CAMERA_MATCH_STREAK=3
